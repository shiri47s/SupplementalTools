# =============================================================================
# Java / Gradle / IntelliJ / NeoForge Development
# =============================================================================
#
# Project-wide ignore rules for Java, Gradle, IntelliJ IDEA,
# Minecraft / NeoForge development, operating-system metadata,
# local tooling, caches, and generated artifacts.
#
# Generated game resources are intentionally kept in version control.
# Only transient caches and local runtime data are ignored.
# =============================================================================


# =============================================================================
# IDE / Editor
# =============================================================================

# -----------------------------------------------------------------------------
# IntelliJ IDEA
# -----------------------------------------------------------------------------

.idea/
.idea_modules/

*.iml
*.ipr
*.iws

# IntelliJ / Atlassian plugin
atlassian-ide-plugin.xml


# =============================================================================
# Java / JVM
# =============================================================================

# Compiled classes
*.class

# JVM crash logs
hs_err_pid*
replay_pid*

# Java process logs
*.log


# =============================================================================
# Gradle
# =============================================================================

.gradle/

# Build output
build/
out/

# Gradle GUI / local task state
gradle-app.setting
.gradletasknamecache

# Machine-specific Gradle configuration
local.properties


# =============================================================================
# Cache
# =============================================================================

# Generic cache directories at any depth
.cache/


# =============================================================================
# Gradle Wrapper
# =============================================================================

# The Gradle Wrapper JAR must remain version-controlled even though
# JAR files are ignored below.

!gradle/wrapper/gradle-wrapper.jar


# =============================================================================
# Build Packages / Archives
# =============================================================================

*.jar
*.war
*.nar
*.ear

*.zip
*.tar
*.tar.gz
*.tgz
*.rar

# Keep the Gradle Wrapper binary tracked.
!gradle/wrapper/gradle-wrapper.jar


# =============================================================================
# Minecraft / NeoForge Runtime
# =============================================================================

# Local game / development runtime
run/

# Runtime artifacts
logs/
crash-reports/

# Uncomment if these can also be generated outside run/.
#
# saves/
# screenshots/
# options.txt
# usercache.json


# =============================================================================
# Data Generation
# =============================================================================

# Generated resources themselves ARE committed because they are part of the
# shipped mod: models, recipes, loot tables, tags, worldgen data, etc.
#
# DataGen cache directories are covered globally by:
#
#   .cache/
#
# Therefore files such as:
#
#   neoforge/src/generated/.cache/
#
# are ignored while the generated resources themselves remain tracked.


# =============================================================================
# MCP / Local Agent Configuration
# =============================================================================

# Points to an IDE or MCP service running on this developer's machine.
# It is therefore machine-specific and should not be shared.

.mcp.json


# =============================================================================
# Temporary / Backup Files
# =============================================================================

*~
*.tmp
*.temp
*.swp
*.swo

# File-system temporary artifacts
.fuse_hidden*
.nfs*


# =============================================================================
# macOS
# =============================================================================

.DS_Store
.AppleDouble
.LSOverride
._*

# Custom folder icon metadata
Icon?

# Volume / filesystem metadata
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# AFP / network-share metadata
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk


# =============================================================================
# Windows
# =============================================================================

# Thumbnail caches
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Crash / dump files
*.stackdump

# Folder metadata
[Dd]esktop.ini

# Recycle Bin
$RECYCLE.BIN/

# Installer packages
*.cab
*.msi
*.msix
*.msm
*.msp

# Shortcuts
*.lnk


# =============================================================================
# Linux / Unix Desktop
# =============================================================================

.directory
.Trash-*


# =============================================================================
# Optional Local Configuration
# =============================================================================

# .env
# .env.*
# !.env.example
#
# *.local
# *.local.properties
