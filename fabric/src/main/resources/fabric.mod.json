{
  "schemaVersion": 1,
  "id": "sptools",
  "version": "${version}",
  "name": "SupplementalTools",
  "description": "Supplemental Tools provides subtle, non-intrusive additions to enhance your everyday Minecraft gameplay experience.",
  "authors": [
    "shiri47s"
  ],
  "contact": {
    "homepage": "https://github.com/shiri47s/SupplementalTools"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.syshima.sptools.fabric.ModFabric"
    ],
    "fabric-datagen": [
      "net.syshima.sptools.fabric.datagen.ModDataGenerator"
    ]
  },
  "mixins": [
    "sptools.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "architectury": ">=22.0.2",
    "fabric-api": "*"
  },
  "suggests": {
    "trinkets_updated": ">=4.2.0",
    "lambdynamiclights": "*"
  }
}
